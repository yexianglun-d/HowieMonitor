{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "skipLibCheck": true, "isolatedModules": true,
    "noEmit": true, "allowImportingTsExtensions": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
