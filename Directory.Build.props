<Project>
  <PropertyGroup>
    <MonitorVersion>0.2.2</MonitorVersion>
    <MonitorBuildId Condition="'$(MonitorBuildId)' == ''">development</MonitorBuildId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MonitorVersion" Value="$(MonitorVersion)" />
    <AssemblyMetadata Include="MonitorBuildId" Value="$(MonitorBuildId)" />
  </ItemGroup>
</Project>
